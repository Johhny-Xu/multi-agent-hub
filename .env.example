# ==============================================================
# Multi-Agent Hub 统一配置 / Unified Configuration
# ==============================================================
# 复制本文件为 .env 即可生效：cp .env.example .env
# Copy this file to .env to take effect: cp .env.example .env

# --------------------------------------------------------------
# 1. 任务总线配置 / Task Bus (Python MCP Server)
# --------------------------------------------------------------
# 监听地址与端口 / Host & Port
AGENTHUB_HOST=127.0.0.1
AGENTHUB_PORT=8765

# 访问鉴权令牌 / Auth Token
# 注意：若 AGENTHUB_HOST 非回环 (非 127.0.0.1/localhost)，必须设置强 Token 防未授权访问！
# Note: If listening on 0.0.0.0 or LAN IP, HUB_TOKEN must be non-empty!
HUB_TOKEN=

# 任务判定僵死超时时间 (秒) / Stale task timeout (seconds)
HUB_STALE_RUNNING_SEC=1800

# --------------------------------------------------------------
# 2. Web 控制台配置 / Web Console (Node.js)
# --------------------------------------------------------------
# 控制台访问主机与端口 / Console Host & Port
HUBCONSOLE_HOST=127.0.0.1
HUBCONSOLE_PORT=8890

# 控制台连向总线的 URL 与 Token / Backend connection to Task Bus
HUBCONSOLE_SERVER_URL=http://127.0.0.1:8765/mcp
HUBCONSOLE_SERVER_TOKEN=

# 控制台身份名称与角色 / Console identity & role
HUBCONSOLE_SELF_AGENT=console
HUBCONSOLE_SELF_ROLE=子代理控制台

# --------------------------------------------------------------
# 3. 驱动与网关 / Drivers & Gateway (可选 / Optional)
# --------------------------------------------------------------
# TraeClaw 网关地址 (桌面 Trae 桥接)
TRAE_GATEWAY=http://127.0.0.1:8787

# 默认 CDP 调试端口 (桌面 AI 驱动)
CDP_PORT=9222
