[Unit]
Description=CodeBuddy Web UI Server (Domestic CN)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=CODEBUDDY_CONFIG_DIR=%h/.codebuddy-cn
Environment=CODEBUDDY_INTERNET_ENVIRONMENT=internal
Environment=CODEBUDDY_API_KEY_DISABLED=1
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.npm-global/bin/codebuddy --serve --port 7454 --host 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
