# Agent Hub 环境变量示例 —— 复制为 hub.env（或 systemd EnvironmentFile）并填入真实值；切勿提交真实值
# HTTP 访问令牌：AGENTHUB_HOST 为非回环地址（如 0.0.0.0/局域网 IP）时必须设置，否则拒绝启动
HUB_TOKEN=
# 枢纽 HTTP 绑定地址/端口（默认 127.0.0.1:8765；也可用命令行 --host/--http 覆盖）
AGENTHUB_HOST=127.0.0.1
AGENTHUB_PORT=8765
# TraeClaw 网关地址（trae_delegate / trae 通道）
TRAE_GATEWAY=http://127.0.0.1:8787
# trae_mcp_server 的访问令牌（可选）
TRAE_MCP_TOKEN=
