{
  "agents": {
    "codearts": {
      "role": "华为云码道 CodeArts 官方通道",
      "description": "通过驱动调用已安装的官方 CodeArts CLI 或 IDE kernel；默认继承 CodeArts 本机配置的模型。需要为所选正式通道完成认证，不将桌面登录视为 CLI 已授权。",
      "cli": [
        "python3",
        "/PATH/TO/multi-agent-hub/drivers/codearts_cli.py",
        "--task",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": ""
      },
      "timeout_arg": "--timeout",
      "workdir_via": "--cwd",
      "async_default": true
    },
    "codebuddy": {
      "role": "编码 worker 示例（CLI 无头模式）",
      "description": "编码 worker 示例（CLI 无头模式）; cli 路径请替换为本机真实可执行文件。models 为模型别名表。",
      "cli": [
        "/usr/local/bin/codebuddy-placeholder",
        "-p",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "deepseek-v4.1-flash",
        "luna": "gpt-5.6-luna",
        "deepseekv41f": "deepseek-v4.1-flash",
        "grok4.7": "grok-4.7",
        "grok-4.7": "grok-4.7",
        "v41f": "deepseek-v4.1-flash"
      },
      "async_default": true
    },
    "antigravity": {
      "role": "编码 worker 示例（OAuth CLI）",
      "description": "编码 worker 示例（OAuth CLI）; cli 路径请替换为本机真实可执行文件。models 为模型别名表。",
      "cli": [
        "/usr/local/bin/antigravity-placeholder",
        "-p",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "gemini-3.8-flash-medium",
        "gemini": "gemini-3.8-flash-high",
        "pro": "gemini-3.1-pro-high",
        "claude": "claude-sonnet-4-6",
        "opus": "claude-opus-4-6-thinking",
        "flash": "gemini-3.7-flash-medium",
        "g38m": "gemini-3.8-flash-medium"
      },
      "async_default": true,
      "options_before_prompt": true
    },
    "codebuddy-cn": {
      "role": "编码 worker 示例（独立配置目录）",
      "description": "编码 worker 示例（独立配置目录）; cli 路径请替换为本机真实可执行文件。models 为模型别名表。",
      "cli": [
        "/usr/local/bin/codebuddy-cn-placeholder",
        "-p",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "deepseek-v4.1-flash",
        "v41f": "deepseek-v4.1-flash"
      },
      "workdir_via": "--add-dir",
      "async_default": true
    },
    "opencode": {
      "role": "opencode 官方 CLI（run 非交互模式）",
      "description": "opencode run 无头执行，--format json 输出事件流；cli 路径请替换为本机真实可执行文件。模型格式 provider/model，需先 opencode auth login。",
      "cli": [
        "/usr/local/bin/opencode-placeholder",
        "run",
        "--format",
        "json",
        "{task}"
      ],
      "model_arg": "-m",
      "models": {
        "default": "",
        "ds41f": "opencode/deepseek-v4.1-flash-free",
        "glm53f": "opencode/glm-5.3-flash-free",
        "mimo26f": "opencode/mimo-v2.6-flash-free",
        "longcat": "opencode/longcat-2.5-preview-free",
        "nemotron3u": "opencode/nemotron-3-ultra-free",
        "nemotron35l": "opencode/nemotron-3.5-lightning-free",
        "nemotron35vl": "opencode/nemotron-3.5-super-vl-free",
        "bunny": "opencode/space-bunny-free",
        "beam": "opencode/beam-free",
        "pickle": "opencode/big-pickle"
      },
      "workdir_via": "--dir",
      "async_default": true
    },
    "cline": {
      "role": "Cline 官方 CLI（--json NDJSON 无头模式）",
      "description": "cline --json 无头执行，输出 NDJSON；cli 路径请替换为本机真实可执行文件。需先 cline auth 完成登录。；注意 cline 的 argv 解析要求提示词含空格，cli 末项写作 {task} 加一个尾部空格（无害），否则单字任务会被当成命令名",
      "cli": [
        "/usr/local/bin/cline-placeholder",
        "--json",
        "{task} "
      ],
      "model_arg": "-m",
      "models": {
        "default": "deepseek/deepseek-v4.1-flash",
        "ds": "deepseek/deepseek-v4.1-flash",
        "sonnet": "anthropic/claude-sonnet-5.5",
        "free": "openrouter/free",
        "nem": "nvidia/nemotron-3.5-lightning:free",
        "north": "cohere/north-mini-code:free"
      },
      "timeout_arg": "--timeout",
      "workdir_via": "--cwd",
      "async_default": true
    },
    "traecode": {
      "role": "桌面版 worker 示例（经专用网关派发, cli 为 null）",
      "description": "桌面版 worker 示例（经专用网关派发, cli 为 null）; cli 路径请替换为本机真实可执行文件。models 为模型别名表。",
      "cli": null,
      "model_arg": null,
      "models": {
        "default": "GLM-5.3-FlashX"
      }
    },
    "zcode": {
      "role": "ZCode 官方 app-server 模型校验通道",
      "description": "填写本仓库驱动与官方 zcode.cjs 绝对路径；先核验账号模型目录，再指定模型执行。缺少 GLM-5.3-Flash 时明确失败，不回退。plan 模式仅验证读取/问答。",
      "cli": [
        "node",
        "/PATH/TO/agenthub/drivers/zcode_rpc.mjs",
        "--cli",
        "/PATH/TO/ZCode/resources/glm/zcode.cjs",
        "--task",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "GLM-5.3-Flash"
      },
      "async_default": true,
      "timeout_arg": "--timeout",
      "capabilities": {
        "stream": {
          "on": {
            "args": [
              "--stream",
              "on"
            ]
          },
          "off": {
            "args": [
              "--stream",
              "off"
            ]
          }
        }
      },
      "env": {
        "ZCODE_BUILTIN_PROVIDER_CONFIG_FILE": "/PATH/TO/zcode-builtin.json"
      }
    },
    "mimocode": {
      "role": "编码 worker 示例（agentic CLI，--pure 反递归）",
      "description": "编码 worker 示例（agentic CLI，--pure 反递归）; cli 路径请替换为本机真实可执行文件。models 为模型别名表。",
      "cli": [
        "/usr/local/bin/mimocode-placeholder",
        "run",
        "--pure"
      ],
      "model_arg": "-m",
      "models": {
        "default": "xiaomi/mimo-v2.6-flash",
        "26f": "xiaomi/mimo-v2.6-flash",
        "v2.6f": "xiaomi/mimo-v2.6-flash"
      },
      "async_default": true
    },
    "github-copilot": {
      "role": "GitHub Copilot 官方 CLI（Linux）",
      "description": "官方 copilot 可执行文件；npm 全局安装后通常在 ~/.local/bin/copilot 或 /usr/local/bin/copilot，请改成 which copilot 的实际结果。参数沿用已验证的自动模型与无头提示词写法。",
      "cli": [
        "/usr/local/bin/copilot",
        "--silent",
        "-p",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "auto"
      },
      "async_default": true
    },
    "qoder": {
      "role": "Qoder 官方 CLI（国际版，无头 print 模式）",
      "description": "Qoder 官方 CLI 无头执行；-m 使用 Qoder 模型选择器 key，默认 DeepSeek-Flash (dfmodel，限时 0.1x)；--attachment 传文件/图片，--cwd 指定工作目录。首次使用先在 Hub 主机执行 qodercli login。",
      "cli": [
        "qodercli",
        "-p",
        "{task}"
      ],
      "model_arg": "-m",
      "models": {
        "default": "dfmodel",
        "flash": "dfmodel",
        "deepseek-flash": "dfmodel",
        "dsflash": "dfmodel",
        "pro": "dmodel",
        "deepseek-pro": "dmodel",
        "qwen": "qmodel_38max",
        "glm": "gmodel",
        "kimi": "kmodel_latest",
        "minimax": "mmodel",
        "auto": "auto"
      },
      "workdir_via": "--cwd",
      "async_default": true,
      "login": {
        "command": [
          "qodercli",
          "login"
        ],
        "status_command": [
          "qodercli",
          "status",
          "-o",
          "json"
        ]
      }
    },
    "qoder-cn": {
      "role": "Qoder CN 官方 CLI（国内版，无头 print 模式）",
      "description": "Qoder CN 官方 CLI 无头执行；与 qodercli 参数一致（-p / -m / --attachment / --cwd），配置目录为 ~/.qoder-cn。默认 DeepSeek-Flash (dfmodel，限时 0.1x)；首次使用先在 Hub 主机执行 qoderclicn login。",
      "cli": [
        "qoderclicn",
        "-p",
        "{task}"
      ],
      "model_arg": "-m",
      "models": {
        "default": "dfmodel",
        "flash": "dfmodel",
        "deepseek-flash": "dfmodel",
        "dsflash": "dfmodel",
        "pro": "dmodel",
        "deepseek-pro": "dmodel",
        "qwen": "qmodel_38max",
        "glm": "gmodel",
        "kimi": "kmodel_latest",
        "minimax": "mmodel",
        "auto": "auto"
      },
      "workdir_via": "--cwd",
      "async_default": true,
      "login": {
        "command": [
          "qoderclicn",
          "login"
        ],
        "status_command": [
          "qoderclicn",
          "status",
          "-o",
          "json"
        ]
      }
    },
    "minimaxcode": {
      "role": "MiniMax Code worker（官方 mcode CLI 无头 exec）",
      "description": "mcode exec --prompt-mode work --output-format text 无头执行（agent 模式）；与 MiniMax Code 桌面端同一账号体系（签到赠予积分在 Code 内可用）；未登录时会直接报 Sign in to MiniMax。模型引用是 provider/model，国内区与国际区都是 minimax/*（默认 minimax/MiniMax-M3.1-Flash，可选 minimax/MiniMax-M3）。",
      "cli": [
        "/home/johhny/.minimax-code/bin/mcode",
        "exec",
        "--prompt-mode",
        "work",
        "--permission",
        "smart",
        "--output-format",
        "text",
        "{task}"
      ],
      "model_arg": "--model",
      "workdir_via": "--cwd",
      "async_default": true,
      "allow_unlisted_models": true,
      "models": {
        "default": "minimax/MiniMax-M3.1-Flash",
        "3.1f": "minimax/MiniMax-M3.1-Flash",
        "m3": "minimax/MiniMax-M3"
      }
    }
  }
}
