      "image": {
        "mode": "messages_file"
      }
    },
    "notes": "MiniMax-M3.1-Flash-Preview always uses thinking; off is unsupported.",
    "stream_semantics": "answer_deltas"
  },
  "zcode": {
    "attachments": {
      "file": {
        "mode": "cli",
        "flag": "--attach"
      },
      "image": {
        "mode": "cli",
        "flag": "--attach"
      }
    },
    "stream": {
      "on": {
        "args": [
          "--stream",
          "on"
        ],
        "supported": false,
        "reason": "The official app-server returned only terminal results in the verified run; real-time deltas were not observed."
      },
      "off": {
        "args": [
          "--stream",
          "off"
        ]
      }
    },
    "stream_semantics": "terminal_only"
  },
