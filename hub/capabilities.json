{
  "codebuddy": {
    "stream": {
      "on": {
        "args": [
          "--output-format",
          "stream-json",
          "--include-partial-messages"
        ]
      },
      "off": {
        "args": [
          "--output-format",
          "json"
        ],
        "remove_args": [
          "--include-partial-messages"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "stdin_json"
      },
      "image": {
        "mode": "prompt_path",
        "requires_read_authorization": true
      }
    },
    "thinking": {
      "on": {
        "args": [
          "--settings",
          "{\"alwaysThinkingEnabled\":true}"
        ],
        "env": {
          "MAX_THINKING_TOKENS": "4096"
        },
        "models": [
          "deepseek-v4.1-flash"
        ]
      },
      "off": {
        "args": [
          "--settings",
          "{\"alwaysThinkingEnabled\":false}"
        ],
        "env": {
          "MAX_THINKING_TOKENS": "0"
        },
        "models": [
          "deepseek-v4.1-flash"
        ]
      }
    },
    "task_args": [
      "--agent",
      "standard"
    ],
    "stream_semantics": "answer_deltas",
    "notes": "Force official standard agent so remembered PTC/REPL does not hide Read. UTF-8 files use official stdin JSON; images require the verified Read path and explicit narrow headless authorization. Direct deepseek stdin images are not declared verified."
  },
