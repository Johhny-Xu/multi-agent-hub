{
  "codebuddy": {
    "stream": {
      "on": {
        "args": [
          "--output-format",
          "stream-json",
          "--include-partial-messages"
        ]
      },
      "off": {
        "args": [
          "--output-format",
          "json"
        ],
        "remove_args": [
          "--include-partial-messages"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "stdin_json"
      },
      "image": {
        "mode": "prompt_path",
        "requires_read_authorization": true
      }
    },
    "thinking": {
      "on": {
        "args": [
          "--settings",
          "{\"alwaysThinkingEnabled\":true}"
        ],
        "env": {
          "MAX_THINKING_TOKENS": "4096"
        },
        "models": [
          "deepseek-v4.1-flash"
        ]
      },
      "off": {
        "args": [
          "--settings",
          "{\"alwaysThinkingEnabled\":false}"
        ],
        "env": {
          "MAX_THINKING_TOKENS": "0"
        },
        "models": [
          "deepseek-v4.1-flash"
        ]
      }
    },
    "task_args": [
      "--agent",
      "standard"
    ],
    "stream_semantics": "answer_deltas",
    "notes": "Force official standard agent so remembered PTC/REPL does not hide Read. UTF-8 files use official stdin JSON; images require the verified Read path and explicit narrow headless authorization. Direct deepseek stdin images are not declared verified. To enable image attachments: add \"--allowedTools Read --permission-mode acceptEdits\" to the agent CLI (grants Read + auto-accepted edits).",
    "permission": {
      "description": "--permission-mode",
      "modes": {
        "readonly": {
          "label": "只读",
          "args": [
            "--permission-mode",
            "plan"
          ],
          "desc": "plan 模式只允许读与规划，不落盘改文件"
        },
        "edit": {
          "label": "受控编辑",
          "args": [
            "--permission-mode",
            "acceptEdits"
          ],
          "desc": "文件编辑自动通过，其余工具仍需确认"
        },
        "full": {
          "label": "完全控制",
          "args": [
            "--permission-mode",
            "bypassPermissions"
          ],
          "desc": "跳过所有确认（高危操作仍会询问）"
        }
      }
    }
  },
