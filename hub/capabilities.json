  "minimaxcode": {
    "attachments": {
      "file": {
        "mode": "messages_file"
      },
      "image": {
        "mode": "messages_file"
      }
    },
    "permission": {
      "description": "--permission",
      "modes": {
        "edit": {
          "label": "受控编辑",
          "args": ["--permission", "smart", "--prompt-mode", "work"],
          "desc": "smart 策略 + work agent 提示词（默认）：可读写文件，其余工具按策略处理"
        },
        "full": {
          "label": "完全控制",
          "args": ["--permission", "full", "--prompt-mode", "work"],
          "desc": "full 策略：跳过所有确认，可自由读写文件（已实测落盘）"
        }
      }
    },
    "notes": "mcode exec 无头模式（--output-format text）：与 MiniMax Code 桌面端同一账号，登录态缺失时 exec 会直接报 Sign in to MiniMax。模型引用是 provider/model，国内区与国际区都是 minimax/*（实测 minimax/MiniMax-M3.1-Flash 与 minimax/MiniMax-M3 均可用；minimax-cn/* 会报 not available for the configured_provider route）。agent 模式由 --prompt-mode work 开启。注意：mcode 的 --permission off 是「关闭权限询问」= 全放开，**不是只读**（实测 off 与 smart 都能落盘），所以不声明 readonly 档，只给 edit(smart) / full(full)。"
  },
  "zcode": {
    "attachments": {
      "file": {
        "mode": "cli",
        "flag": "--attach"
      },
      "image": {
        "mode": "cli",
        "flag": "--attach"
      }
    },
    "stream": {
      "on": {
        "args": [
          "--stream",
          "on"
        ],
        "supported": false,
        "reason": "The official app-server returned only terminal results in the verified run; real-time deltas were not observed."
      },
      "off": {
        "args": [
          "--stream",
          "off"
        ]
      }
    },
    "stream_semantics": "terminal_only"
  },
  "codearts": {
    "thinking": {
      "on": {
        "supported": false,
        "reason": "CodeArts --thinking controls display only; provider-specific reasoning variants have not been verified for the configured model."
      },
      "off": {
        "supported": false,
        "reason": "No strict thinking-off control has been verified for the configured CodeArts model; inherit its default behavior."
      }
    },
    "stream": {
      "on": {
        "supported": false,
        "reason": "CodeArts JSON event output does not establish verified incremental answer delivery; the current driver returns the terminal result."
      },
      "off": {
        "args": [
          "--stream",
          "off"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "cli",
        "flag": "--attach",
        "reason": "Driver validates UTF-8 text (suffix allowlist, <=10MB) and forwards to the CodeArts CLI --file channel."
      },
      "image": {
        "supported": false,
        "reason": "CodeArts CLI --file may label an image as text/plain; end-to-end image MIME and visual understanding have not been verified."
      }
    },
    "stream_semantics": "terminal_only",
    "notes": "Use the official CodeArts configured default model unless a locally declared model is explicitly selected. CLI presence, OAuth records and exit code zero do not establish successful authentication or model execution."
  },
