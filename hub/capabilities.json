  "github-copilot": {
    "thinking": {
      "off": {
        "args": [
          "--reasoning-effort",
          "none"
        ],
        "supported": false,
        "reason": "auto routes to changing models; accepting none is not evidence of a strict thinking-off guarantee. Pin and verify a specific model before declaring this control."
      }
    },
    "stream": {
      "on": {
        "args": [
          "--stream",
          "on",
          "--output-format",
          "json"
        ]
      },
      "off": {
        "args": [
          "--stream",
          "off",
          "--output-format",
          "json"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "prompt_path"
      },
      "image": {
        "mode": "cli",
        "flag": "--attachment"
      }
    },
    "notes": "auto exposes default thinking only. Per-model thinking controls must be explicitly verified and declared in the local profile.",
    "stream_semantics": "answer_deltas",
    "permission": {
      "description": "--allow-all-tools",
      "modes": {
        "full": {
          "label": "完全控制",
          "args": [
            "--allow-all-tools",
            "--allow-all-paths"
          ],
          "desc": "放行所有工具与任意路径（无只读开关）"
        }
      }
    }
  },
  "mimocode": {
    "stream": {
      "on": {
        "args": [
          "--format",
          "json"
        ]
      },
      "off": {
        "args": [
          "--format",
          "json"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "cli",
        "flag": "--file"
      },
      "image": {
        "mode": "cli",
        "flag": "--file"
      }
    },
    "thinking": {
      "on": {
        "args": [],
        "models": [
          "xiaomi/mimo-v2.6-flash"
        ],
        "env": {
          "MIMOCODE_CONFIG_CONTENT": "{\"provider\":{\"xiaomi\":{\"models\":{\"mimo-v2.6-flash\":{\"options\":{\"thinking\":{\"type\":\"enabled\"}}}}}}}"
        }
      },
      "off": {
        "args": [],
        "models": [
          "xiaomi/mimo-v2.6-flash"
        ],
        "env": {
          "MIMOCODE_CONFIG_CONTENT": "{\"provider\":{\"xiaomi\":{\"models\":{\"mimo-v2.6-flash\":{\"options\":{\"thinking\":{\"type\":\"disabled\"}}}}}}}"
        }
      }
    },
    "stream_semantics": "answer_snapshots"
  },
  "minimaxcode": {
    "thinking": {
      "on": {
        "args": [],
        "models": [
          "MiniMax-M3.1-Flash-Preview"
        ]
      }
    },
    "stream": {
      "on": {
        "args": [
          "--output",
          "text",
          "--stream"
        ]
      },
      "off": {
        "args": [
          "--output",
          "json"
        ],
        "remove_args": [
          "--stream"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "messages_file"
      },
      "image": {
        "mode": "messages_file"
      }
    },
    "notes": "MiniMax-M3.1-Flash-Preview always uses thinking; off is unsupported.",
    "stream_semantics": "answer_deltas"
  },
  "zcode": {
    "attachments": {
      "file": {
        "mode": "cli",
        "flag": "--attach"
      },
      "image": {
        "mode": "cli",
        "flag": "--attach"
      }
    },
    "stream": {
      "on": {
        "args": [
          "--stream",
          "on"
        ],
        "supported": false,
        "reason": "The official app-server returned only terminal results in the verified run; real-time deltas were not observed."
      },
      "off": {
        "args": [
          "--stream",
          "off"
        ]
      }
    },
    "stream_semantics": "terminal_only"
  },
  "codearts": {
    "thinking": {
      "on": {
        "supported": false,
        "reason": "CodeArts --thinking controls display only; provider-specific reasoning variants have not been verified for the configured model."
      },
      "off": {
        "supported": false,
        "reason": "No strict thinking-off control has been verified for the configured CodeArts model; inherit its default behavior."
      }
    },
    "stream": {
      "on": {
        "supported": false,
        "reason": "CodeArts JSON event output does not establish verified incremental answer delivery; the current driver returns the terminal result."
      },
      "off": {
        "args": [
          "--stream",
          "off"
        ]
      }
    },
    "attachments": {
      "file": {
        "supported": false,
        "reason": "File attachment delivery has not passed a real authenticated CodeArts model request on this adapter."
      },
      "image": {
        "supported": false,
        "reason": "CodeArts CLI --file may label an image as text/plain; end-to-end image MIME and visual understanding have not been verified."
      }
    },
    "stream_semantics": "terminal_only",
    "notes": "Use the official CodeArts configured default model unless a locally declared model is explicitly selected. CLI presence, OAuth records and exit code zero do not establish successful authentication or model execution."
  },
  "antigravity": {
    "attachments": {
      "file": {
        "mode": "prompt_path"
      },
      "image": {
        "mode": "prompt_path"
      }
    },
    "permission": {
      "description": "--mode",
      "modes": {
        "readonly": {
          "label": "只读",
          "args": [
            "--mode",
            "plan"
          ],
          "desc": "只规划不改文件"
        },
        "edit": {
          "label": "受控编辑",
          "args": [
            "--mode",
            "accept-edits"
          ],
          "desc": "自动接受文件编辑"
        },
        "full": {
          "label": "完全控制",
          "args": [
            "--mode",
            "auto"
          ],
          "desc": "全自动，跳过确认"
        }
      }
    }
  },
  "traecode": {
