    "permission": {
      "description": "--agent plan",
      "modes": {
        "readonly": {
          "label": "只读",
          "args": [
            "--agent",
            "plan"
          ],
          "desc": "切换到 plan agent，只读不改文件"
        },
        "full": {
          "label": "完全控制",
          "args": [
            "--auto"
          ],
          "desc": "自动批准未被显式禁止的权限"
        }
