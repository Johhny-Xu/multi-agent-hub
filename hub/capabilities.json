  "qoder": {
    "stream": {
      "on": {
        "args": [
          "--output-format",
          "stream-json"
        ]
      },
      "off": {
        "args": [
          "--output-format",
          "json"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "cli",
        "flag": "--attachment"
      },
      "image": {
        "mode": "cli",
        "flag": "--attachment"
      }
    },
    "thinking": {
      "on": {
        "args": [
          "--thinking",
          "enabled"
        ]
      },
      "off": {
        "args": [
          "--thinking",
          "disabled"
        ]
      }
    },
    "stream_semantics": "answer_snapshots",
    "notes": "Qoder CLI -p prints one result; --output-format stream-json emits system/assistant/result records (assistant records are message snapshots, not deltas). -m takes the model selector key shown in the IDE (default DeepSeek-Flash = dfmodel, 0.1x, limited-time free). --attachment carries files and images. The built-in Plan agent is read-only.",
    "permission": {
      "description": "--permission-mode / --agent Plan",
      "modes": {
        "readonly": {
          "label": "只读",
          "args": [
            "--agent",
            "Plan"
          ],
          "desc": "Plan 代理只读规划，不落盘改文件"
        },
        "edit": {
          "label": "受控编辑",
          "args": [
            "--permission-mode",
            "accept_edits"
          ],
          "desc": "文件编辑自动通过，其余仍需确认"
        },
        "full": {
          "label": "完全控制",
          "args": [
            "--permission-mode",
            "bypass_permissions"
          ],
          "desc": "跳过所有确认（高危操作仍会询问）"
        }
      }
    }
  },
