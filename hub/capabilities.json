  },
  "opencode": {
    "stream": {
      "on": {
        "args": [
          "--format",
          "json"
        ]
      },
      "off": {
        "args": [
          "--format",
          "json"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "cli",
        "flag": "--file"
      },
      "image": {
        "mode": "cli",
        "flag": "--file"
      }
    },
    "stream_semantics": "answer_snapshots",
    "notes": "opencode run --format json emits an event stream; text parts arrive as per-part snapshots keyed by messageID. Thinking display is a --thinking flag, not a provider reasoning guarantee, so no thinking control is declared.",
    "permission": {
      "description": "--agent plan",
      "modes": {
        "readonly": {
          "label": "只读",
          "args": [
            "--agent",
            "plan"
          ],
          "desc": "切换到 plan agent，只读不改文件"
        },
        "full": {
          "label": "完全控制",
          "args": [
            "--auto"
          ],
          "desc": "自动批准未被显式禁止的权限"
        }
      }
    }
  },
  "cline": {
    "stream": {
      "on": {
        "args": [
          "--json"
        ]
      },
      "off": {
        "args": [
          "--json"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "prompt_path"
      },
      "image": {
        "mode": "prompt_path"
      }
    },
    "stream_semantics": "answer_snapshots",
    "notes": "cline --json streams NDJSON say/agent_event lines with a final run_result carrying the answer text. Attachments are delivered as @path mentions in the prompt. Auto-approval follows the CLI's own configuration; the hub does not pass --yolo.",
    "permission": {
      "description": "--plan / --yolo",
      "modes": {
        "readonly": {
          "label": "只读",
          "args": [
            "--plan"
          ],
          "desc": "plan 模式只读"
        },
        "full": {
          "label": "完全控制",
          "args": [
            "--yolo"
          ],
          "desc": "yolo 自动批准受限工具集"
        }
      }
    }
  }
}
