  "github-copilot": {
    "thinking": {
      "off": {
        "args": [
          "--reasoning-effort",
          "none"
        ],
        "supported": false,
        "reason": "auto routes to changing models; accepting none is not evidence of a strict thinking-off guarantee. Pin and verify a specific model before declaring this control."
      }
    },
    "stream": {
      "on": {
        "args": [
          "--stream",
          "on",
          "--output-format",
          "json"
        ]
      },
      "off": {
        "args": [
          "--stream",
          "off",
          "--output-format",
          "json"
        ]
      }
    },
    "attachments": {
      "file": {
        "mode": "prompt_path"
      },
      "image": {
        "mode": "cli",
        "flag": "--attachment"
      }
    },
    "notes": "auto exposes default thinking only. Per-model thinking controls must be explicitly verified and declared in the local profile.",
    "stream_semantics": "answer_deltas",
    "permission": {
      "description": "--allow-all-tools",
      "modes": {
        "full": {
          "label": "完全控制",
          "args": [
            "--allow-all-tools",
            "--allow-all-paths"
          ],
          "desc": "放行所有工具与任意路径（无只读开关）"
        }
      }
    }
  },
  "mimocode": {
    "stream": {
      "on": {
        "args": [
          "--format",
          "json"
        ]
      },
