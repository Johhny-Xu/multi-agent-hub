{
  "_comment": "Windows 配置模板。把 C:/PATH/TO 替换为官方 CLI 的稳定安装位置；用 npm root -g 定位 npm 包。只保留已安装的 worker。未含凭据或临时下载路径。真实账号、模型权限与额度仍需实测。",
  "agents": {
    "codearts": {
      "role": "华为云码道 CodeArts 官方 Windows 通道",
      "description": "填写本仓库驱动的稳定绝对路径；驱动查找官方 CodeArts CLI 或 IDE kernel。默认继承 CodeArts 已配置模型，认证失败明确返回，不读取或写入仓库凭据。",
      "cli": [
        "python",
        "C:/PATH/TO/multi-agent-hub/drivers/codearts_cli.py",
        "--task",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {"default": ""},
      "timeout_arg": "--timeout",
      "workdir_via": "--cwd",
      "async_default": true
    },
    "codebuddy": {
      "role": "腾讯 CodeBuddy 国际版 CLI",
      "description": "官方 npm CLI；使用 node + 入口脚本，避免 Windows npm shim 的差异。",
      "cli": [
        "node",
        "C:/PATH/TO/npm/node_modules/@tencent-ai/codebuddy-code/bin/codebuddy",
        "-p",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "deepseek-v4.1-flash",
        "v41f": "deepseek-v4.1-flash"
      },
      "env": {
        "CODEBUDDY_CONFIG_DIR": "%USERPROFILE%/.codebuddy",
        "DISABLE_AUTOUPDATER": "1"
      },
      "async_default": true
    },
    "codebuddy-cn": {
      "role": "腾讯 CodeBuddy 国内版 CLI",
      "description": "与国际版使用相同官方入口，配置目录与网络环境分开。",
      "cli": [
        "node",
        "C:/PATH/TO/npm/node_modules/@tencent-ai/codebuddy-code/bin/codebuddy",
        "-p",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "deepseek-v4.1-flash",
        "v41f": "deepseek-v4.1-flash"
      },
      "env": {
        "CODEBUDDY_CONFIG_DIR": "%USERPROFILE%/.codebuddy-cn",
        "CODEBUDDY_INTERNET_ENVIRONMENT": "internal",
        "DISABLE_AUTOUPDATER": "1"
      },
      "async_default": true
    },
    "antigravity": {
      "role": "Antigravity 官方 agy CLI",
      "description": "填写官方 agy.exe；桌面 Antigravity.exe 不提供此无头接口。",
      "cli": [
        "C:/PATH/TO/agy.exe",
        "--print-timeout",
        "60s",
        "-p",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "gemini-3.8-flash-medium"
      },
      "async_default": true,
      "options_before_prompt": true
    },
    "github-copilot": {
      "role": "GitHub Copilot 官方 Windows CLI",
      "description": "填写官方 copilot.exe，采用已验证的自动模型与无头提示词参数。",
      "cli": [
        "C:/PATH/TO/copilot.exe",
        "--silent",
        "-p",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "auto"
      },
      "async_default": true
    },
    "minimaxcode": {
      "role": "MiniMax 官方 mmx 文本 CLI",
      "description": "纯文本/问答入口；填写稳定安装的 mmx-cli/dist/mmx.mjs。",
      "cli": [
        "node",
        "C:/PATH/TO/npm/node_modules/mmx-cli/dist/mmx.mjs",
        "text",
        "chat",
        "--message",
        "{task}",
        "--output",
        "text"
      ],
      "model_arg": "--model",
      "models": {
        "default": "MiniMax-M3.1-Flash-Preview",
        "m31flash": "MiniMax-M3.1-Flash-Preview"
      },
      "async_default": true
    },
    "mimocode": {
      "role": "小米 MiMo 官方 CLI",
      "description": "使用官方纯净配置与用户指定的 v2.6f 模型。",
      "cli": [
        "node",
        "C:/PATH/TO/npm/node_modules/@mimo-ai/cli/bin/mimo",
        "run",
        "--pure",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "xiaomi/mimo-v2.6-flash",
        "v2.6f": "xiaomi/mimo-v2.6-flash",
        "26f": "xiaomi/mimo-v2.6-flash"
      },
      "async_default": true
    },
    "zcode": {
      "role": "ZCode 官方 app-server 模型校验通道",
      "description": "填写本仓库驱动与官方 zcode.cjs 绝对路径；先核验账号模型目录，再指定模型执行。缺少 GLM-5.3-Flash 时明确失败，不回退。plan 模式仅验证读取/问答。",
      "cli": [
        "node",
        "C:/PATH/TO/agenthub/drivers/zcode_rpc.mjs",
        "--cli",
        "C:/Program Files/ZCode/resources/glm/zcode.cjs",
        "--task",
        "{task}"
      ],
      "model_arg": "--model",
      "models": {
        "default": "GLM-5.3-Flash"
      },
      "env": {
        "ZCODE_BUILTIN_PROVIDER_CONFIG_FILE": "C:/PATH/TO/zcode-builtin.json"
      },
      "async_default": true,
      "timeout_arg": "--timeout",
      "capabilities": {
        "stream": {
          "on": {
            "args": [
              "--stream",
              "on"
            ]
          },
          "off": {
            "args": [
              "--stream",
              "off"
            ]
          }
        }
      }
    },
    "opencode": {
      "role": "opencode 官方 CLI（run 非交互模式）",
      "description": "填写 npm 全局安装的实际二进制（opencode-ai 按平台分发原生 exe，位于 npm 全局 node_modules 的 opencode-* 平台包 bin 目录）；避免 .cmd shim。需先 opencode auth login。",
      "cli": [
        "C:/PATH/TO/opencode.exe",
        "run",
        "--format",
        "json",
        "{task}"
      ],
      "model_arg": "-m",
      "models": {
        "default": "",
        "ds41f": "opencode/deepseek-v4.1-flash-free",
        "glm53f": "opencode/glm-5.3-flash-free",
        "mimo26f": "opencode/mimo-v2.6-flash-free",
        "longcat": "opencode/longcat-2.5-preview-free",
        "nemotron3u": "opencode/nemotron-3-ultra-free",
        "nemotron35l": "opencode/nemotron-3.5-lightning-free",
        "nemotron35vl": "opencode/nemotron-3.5-super-vl-free",
        "bunny": "opencode/space-bunny-free",
        "beam": "opencode/beam-free",
        "pickle": "opencode/big-pickle"
      },
      "workdir_via": "--dir",
      "async_default": true
    },
    "cline": {
      "role": "Cline 官方 CLI（--json NDJSON 无头模式）",
      "description": "填写 npm 全局安装的实际二进制（cline 包按平台分发原生 exe，位于 npm 全局 node_modules 的平台包内）；避免 .cmd shim。需先 cline auth 完成登录。；注意 cline 的 argv 解析要求提示词含空格，cli 末项写作 {task} 加一个尾部空格（无害），否则单字任务会被当成命令名",
      "cli": [
        "C:/PATH/TO/cline.exe",
        "--json",
        "{task} "
      ],
      "model_arg": "-m",
      "models": {
        "default": "",
        "ds41f": "cline-free/deepseek-v4.1-flash",
        "mimo26f": "cline-free/mimo-v2.6-flash",
        "muse13c": "cline-free/muse-spark-1.3-contributor",
        "nemotron35vl": "cline-free/nemotron-3.5-super-vl",
        "solar4": "cline-free/solar-mini4",
        "kat": "cline-free/kat-coder-pro"
      },
      "timeout_arg": "--timeout",
      "workdir_via": "--cwd",
      "async_default": true
    },
    "traecode": {
      "role": "TraeCode 桌面网关",
      "description": "保留已建立的 trae_delegate 桌面通道，需要另外配置 TRAE_GATEWAY。原生 traecli.exe 的登录链路尚未通过完整验证。",
      "cli": null,
      "model_arg": null,
      "models": {
        "default": "GLM-5.3-FlashX"
      }
    }
  }
}
